# Virtual Environments
.venv/

# Directories
/data/
/models/
/logs/
/pyragify/
/fromSSD/
# /rebuild/ is bulk data, EXCEPT the scaling manifests: they record how each
# subset was drawn (studies, row count, effective study count) and the diversity
# analysis reads them. A few KB each.
# git never descends into an excluded directory, so a bare "!" exception under
# "/rebuild/" is unreachable -- the whole path chain has to be re-included.
/rebuild/*
!/rebuild/pretrain/
/rebuild/pretrain/*
!/rebuild/pretrain/scaling/
/rebuild/pretrain/scaling/*
!/rebuild/pretrain/scaling/manifest*.json
/.lgraph/
/.claude/
/.agents/

# Cache files
__pycache__/
.DS_Store
*.pyc

# Specific File Extensions
*.npy
*.pth
*.pt
*.npz
# Re-referenced corpus: 10 GB, regenerate with
#   python code/preprocessing/rereference_zero_ppm.py
data/combined/*_ref0ppm.npy
data/combined/*_ref0ppm_clean.npy
data/combined/corpus_v4_ref0ppm*.npy
data/*/*_ref0ppm.npy
node_modules/
package-lock.json
package.json

# ---- run outputs -------------------------------------------------------
# Results JSON is tracked: it is small and it backs every number in the docs
# and decks. The rest of a run is reproducible noise and is not.
results/**/*.log
results/**/*.done
# per-seed frozen-embedding dumps (results/phase2/<objective>_seed<N>/bin_1024/)
results/phase2/*_seed*/
